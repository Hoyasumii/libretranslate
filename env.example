# Copy to .env.test for `pnpm test:live` (the unit tests never need it).
LIBRETRANSLATE_LIVE=1
# A local instance: docker run -p 5000:5000 libretranslate/libretranslate --load-only en,pt,es,fr
LIBRETRANSLATE_URL=http://localhost:5000
# Only for instances that issue keys (e.g. https://libretranslate.com).
# LIBRETRANSLATE_API_KEY=
